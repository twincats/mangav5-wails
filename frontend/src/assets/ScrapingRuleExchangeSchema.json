{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Scraping Rule Exchange Schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "kind",
    "site_key",
    "name",
    "enabled",
    "domains",
    "manga_rule",
    "chapter_rule"
  ],
  "properties": {
    "format_version": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "scraping_rule"
    },
    "site_key": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "enabled": {
      "type": "boolean"
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "manga_rule": {
      "type": "object"
    },
    "chapter_rule": {
      "type": "object"
    }
  }
}
